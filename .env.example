# Desenvolvimento local (sem segredos)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_DIALECT=sqlite
DATABASE_PATH=data/financas.sqlite
CORS_ORIGINS=http://localhost:5173
SERVE_WEB=false
FEATURE_GOOGLE_DRIVE=true
AUTH_ENABLED=false

