# Desenvolvimento local PostgreSQL (sem segredos; exporte DATABASE_URL e SESSION_SECRET no terminal)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_DIALECT=postgres
# DATABASE_URL=postgresql://...
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173
SERVE_WEB=false
FEATURE_GOOGLE_DRIVE=false
AUTH_ENABLED=true
SESSION_SECRET=

# SQLite permanece somente como origem legada para a migração T10.
# DATABASE_PATH=data/financas.sqlite

# Produção (configure os valores secretos somente no Render)
# NODE_ENV=production
# PUBLIC_URL=https://seu-servico.onrender.com
# DATABASE_DIALECT=postgres
# DATABASE_URL=
# SESSION_SECRET=
# AUTH_ENABLED=true
# SESSION_COOKIE_NAME=finances_session
# SESSION_ABSOLUTE_TTL_SECONDS=604800
# SESSION_IDLE_TTL_SECONDS=86400
# CORS_ORIGINS=
# TRUST_PROXY=true
# SERVE_WEB=true
# FEATURE_GOOGLE_DRIVE=false
