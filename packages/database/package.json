{
  "name": "@finances/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:postgres": "node --env-file-if-exists=../../.env --import=tsx/esm src/migrate-postgres.ts",
    "db:seed:postgres": "node --env-file-if-exists=../../.env --import=tsx/esm src/seed-postgres.ts",
    "db:migrate:identity": "tsx src/migrate-identity.ts",
    "db:import:sqlite": "tsx src/migration/import-sqlite.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:demo": "tsx src/seed-demo.ts",
    "db:reset:dev": "tsx src/reset-development.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
